{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "azureOpenAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT}"
    },
    "azureOpenAiApiKey": {
      "value": "${AZURE_OPENAI_API_KEY}"
    },
    "azureOpenAiWhisperDeploymentName": {
      "value": "${AZURE_OPENAI_WHISPER_DEPLOYMENT_NAME}"
    },
    "azureOpenAiContentDeploymentName": {
      "value": "${AZURE_OPENAI_CONTENT_DEPLOYMENT_NAME}"
    },
    "azureAiAgentConnectionString": {
      "value": "${AZURE_AI_AGENT_CONNECTION_STRING}"
    },
    "azureAiAgentChatModelId": {
      "value": "${AZURE_AI_AGENT_CHAT_MODEL_ID}"
    },
    "azureAiAgentVectorStoreId": {
      "value": "${AZURE_AI_AGENT_VECTOR_STORE_ID}"
    },
    "azureAiAgentMaxEvaluations": {
      "value": "${AZURE_AI_AGENT_MAX_EVALUATIONS}"
    },
    "githubPersonalAccessToken": {
      "value": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
    },
    "fileUploadMaxRequestBodySizeInBytes": {
      "value": "${FILE_UPLOAD_MAX_REQUEST_BODY_SIZE_IN_BYTES}"
    },
    "fileUploadAllowedExtensions": {
      "value": "${FILE_UPLOAD_ALLOWED_EXTENSIONS}"
    }
  }
}