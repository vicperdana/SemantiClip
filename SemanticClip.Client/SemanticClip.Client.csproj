<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <UserSecretsId>91c060ad-2964-4b7c-849e-24953f596b68</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="8.5.1" />
    <PackageReference Include="MudBlazor.Markdown" Version="8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Service worker excluded to prevent integrity check failures -->
    <!-- <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" /> -->
  </ItemGroup>

  <ItemGroup>
    <None Include="web.config">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticClip.Core\SemanticClip.Core.csproj" />
    <ProjectReference Include="..\SemanticClip.Services\SemanticClip.Services.csproj" />
  </ItemGroup>

  <!-- Custom target to flatten wwwroot structure for Azure App Service -->
  <Target Name="CopyWwwrootToRoot" AfterTargets="Publish">
    <PropertyGroup>
      <WwwrootPath>$(PublishDir)wwwroot</WwwrootPath>
    </PropertyGroup>
    
    <!-- Move all files from wwwroot to publish root -->
    <ItemGroup>
      <WwwrootFiles Include="$(WwwrootPath)\**\*" />
    </ItemGroup>
    
    <!-- Copy files from wwwroot to root, preserving directory structure -->
    <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" Condition="'%(WwwrootFiles.RecursiveDir)' != ''" />
    
    <!-- Copy files from wwwroot root to publish root -->
    <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(PublishDir)%(Filename)%(Extension)')" Condition="'%(WwwrootFiles.RecursiveDir)' == ''" />
    
    <!-- Remove the wwwroot directory after copying -->
    <RemoveDir Directories="$(WwwrootPath)" />
    
    <!-- Remove service worker files to prevent integrity errors -->
    <Delete Files="$(PublishDir)service-worker.js;$(PublishDir)service-worker.published.js" ContinueOnError="true" />
    
    <!-- Copy web.config and default.html to publish root -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)/web.config" DestinationFiles="$(PublishDir)web.config" Condition="Exists('$(MSBuildProjectDirectory)/web.config')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/default.html" DestinationFiles="$(PublishDir)default.html" Condition="Exists('$(MSBuildProjectDirectory)/default.html')" />
  </Target>

</Project>
