@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<AuthorizeView>
    <Authorized>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Person" Color="Color.Inherit">
            Hello, @context.User.Identity?.Name!
        </MudButton>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ExitToApp" Color="Color.Inherit" Href="authentication/logout">
            Log out
        </MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Login" Color="Color.Primary" Href="authentication/login">
            Log in
        </MudButton>
    </NotAuthorized>
</AuthorizeView>
